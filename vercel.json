{
  "version": 2,
  "rewrites": [
    {
      "source": "/public/:match*",
      "destination": "/public/:match*"
    },
    {
      "source": "/shield",
      "destination": "/shield.html"
    },
    {
      "source": "/rate-card",
      "destination": "/rate-card.html"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index.js"
    }
  ]
}