# ============================================================================
# Dashmesh Properties — Environment Configuration Template (.env.example)
# ============================================================================
# Copy this file to .env and configure with your genuine production credentials.
# NEVER commit .env to version control.

# Server & Security
PORT=3000
NODE_ENV=production
ADMIN_SECRET_KEY=your_strong_admin_secret_key_here
PUBLIC_URL=https://your-domain-or-tunnel.com

# Meta WhatsApp Business Cloud API (Official Cloud API)
# Obtain these from https://developers.facebook.com -> Your App -> WhatsApp -> API Setup
META_ACCESS_TOKEN=your_permanent_system_user_meta_access_token_here
META_APP_SECRET=your_meta_app_secret_here
META_GRAPH_VERSION=v20.0
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_custom_webhook_verification_token_here

# AI Engine (Google Gemini API)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Dashmesh Business & Escalations
# WhatsApp number for receiving owner alerts and escalation notices (in E.164 format without +)
OWNER_ALERT_PHONE=918421077613

# Background Automations & Tunnel
ENABLE_AUTOMATIONS=false
ENABLE_NGROK=false

# Google Business Profile API (Optional Omnichannel Publishing)
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_LOCATION_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Social Media Publishing (Optional Omnichannel Publishing)
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
LINKEDIN_ACCESS_TOKEN=
